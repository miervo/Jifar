# Скопируй в .env.local и заполни. Настоящие значения в репозиторий не коммить.

# Строка подключения к PostgreSQL (только сервер!).
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (порт 6543).
DATABASE_URL="postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Для локального Postgres без TLS раскомментируй:
# DATABASE_SSL="disable"

# Хеш пароля организатора. Получить: npm run hash-password
# Сам пароль нигде не хранится.
ADMIN_PASSWORD_HASH="scrypt:32768:8:1:REPLACE_WITH_SALT:REPLACE_WITH_HASH"

# Длинная случайная строка для обезличивания IP в счётчиках попыток.
# Получить: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RATE_LIMIT_SALT="REPLACE_WITH_RANDOM_STRING"

# Необязательно: срок жизни сессии организатора в часах (по умолчанию 8).
# ADMIN_SESSION_TTL_HOURS="8"

# Необязательно: часовой пояс для дат в CSV (по умолчанию Europe/Moscow).
# APP_TIMEZONE="Europe/Moscow"
